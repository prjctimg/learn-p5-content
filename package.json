{
  "name": "learn-p5-content",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build/reference.mjs && node scripts/build/content.mjs",
    "bundle-validation": "node scripts/bundle/validation.mjs",
    "check-exercises": "node scripts/check/exercises.mjs",
    "check-symbols": "node scripts/check/symbols.mjs",
    "test": "node --test scripts/lib/description-format.test.mjs",
    "check": "npm test && npm run bundle-validation && npm run check-exercises && npm run check-symbols"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2"
  }
}
